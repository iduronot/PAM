<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/sidebar') %>
<div class="main">
  <%- include('../partials/topbar', { pageTitle: 'Rekap Keuangan' }) %>
  <div class="content">
    <%- include('../partials/flash') %>

    <!-- Header + filter tahun -->
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
      <div>
        <h2 style="font-size:18px;font-weight:700;margin:0;">Rekap Keuangan Bulanan</h2>
        <div style="font-size:12px;color:var(--muted);margin-top:2px;">Ringkasan per bulan — beban, pemakaian air, hibah, pengeluaran & saldo</div>
      </div>
      <form method="GET" style="display:flex;gap:8px;align-items:center;">
        <select name="tahun" class="form-control" style="width:auto;">
          <% tahunList.forEach(y => { %>
          <option value="<%= y %>" <%= tahun==y?'selected':'' %>><%= y %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-primary btn-sm">Tampilkan</button>
        <a href="/keuangan" class="btn btn-secondary btn-sm">Ringkasan</a>
      </form>
    </div>

    <%
      let totBeban=0, totAir=0, totKubik=0, totHibah=0, totMasuk=0, totKeluar=0, totSaldo=0;
      let totKelAbodemen=0, totKelAir=0, totKelHibah=0, totKelLain=0;
      tabelBulanan.forEach(r => {
        totBeban       += r.bebanBulanan;
        totAir         += r.biayaAir;
        totKubik       += r.kubik;
        totHibah       += r.hibah;
        totMasuk       += r.totalMasuk;
        totKeluar      += r.pengeluaran;
        totSaldo       += r.saldo;
        totKelAbodemen += r.keluarAbodemen;
        totKelAir      += r.keluarAir;
        totKelHibah    += r.keluarHibah;
        totKelLain     += r.keluarLain;
      });
    %>

    <!-- Kartu ringkasan tahun -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;">
      <div class="card" style="padding:16px;border-top:3px solid var(--primary);">
        <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Total Beban <%= tahun %></div>
        <div style="font-size:18px;font-weight:800;color:var(--primary);"><%= formatRupiah(totBeban) %></div>
      </div>
      <div class="card" style="padding:16px;border-top:3px solid var(--success);">
        <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Total Biaya Air <%= tahun %></div>
        <div style="font-size:18px;font-weight:800;color:var(--success);"><%= formatRupiah(totAir) %></div>
        <div style="font-size:11px;color:var(--muted);margin-top:3px;"><%= totKubik.toLocaleString('id-ID',{maximumFractionDigits:1}) %> m³</div>
      </div>
      <div class="card" style="padding:16px;border-top:3px solid var(--danger);">
        <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Total Pengeluaran <%= tahun %></div>
        <div style="font-size:18px;font-weight:800;color:var(--danger);"><%= formatRupiah(totKeluar) %></div>
      </div>
      <div class="card" style="padding:16px;border-top:3px solid <%= totSaldo >= 0 ? 'var(--primary)' : 'var(--warning)' %>;">
        <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Saldo Bersih <%= tahun %></div>
        <div style="font-size:18px;font-weight:800;color:<%= totSaldo >= 0 ? 'var(--primary)' : 'var(--warning)' %>;"><%= totSaldo < 0 ? '-' : '' %><%= formatRupiah(Math.abs(totSaldo)) %></div>
        <div style="font-size:11px;font-weight:700;color:<%= totSaldo >= 0 ? 'var(--success)' : 'var(--warning)' %>;margin-top:3px;"><%= totSaldo >= 0 ? '▲ Surplus' : '▼ Defisit' %></div>
      </div>
    </div>

    <!-- Tabel dengan Tab -->
    <div class="card" style="padding:0;overflow:hidden;">

      <!-- Tab header -->
      <div style="display:flex;border-bottom:2px solid var(--border);">
        <button id="tab-masuk" onclick="switchTab('masuk')"
          style="padding:14px 24px;font-size:13px;font-weight:600;border:none;cursor:pointer;border-bottom:3px solid var(--primary);margin-bottom:-2px;background:transparent;color:var(--primary);">
          📥 Pemasukan
        </button>
        <button id="tab-keluar" onclick="switchTab('keluar')"
          style="padding:14px 24px;font-size:13px;font-weight:600;border:none;cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-2px;background:transparent;color:var(--muted);">
          📤 Pengeluaran per Dana
        </button>
        <button id="tab-sisa" onclick="switchTab('sisa')"
          style="padding:14px 24px;font-size:13px;font-weight:600;border:none;cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-2px;background:transparent;color:var(--muted);">
          💰 Sisa Dana
        </button>
      </div>

      <!-- Panel Pemasukan -->
      <div id="panel-masuk" style="overflow-x:auto;padding:0;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
          <thead>
            <tr style="background:var(--sub-bg);">
              <% const th = 'padding:11px 14px;font-size:10px;text-transform:uppercase;letter-spacing:.5px;border-bottom:2px solid var(--border);white-space:nowrap;'; %>
              <th style="<%= th %>text-align:left;color:var(--muted);width:40px;">No</th>
              <th style="<%= th %>text-align:left;color:var(--muted);">Bulan</th>
              <th style="<%= th %>text-align:right;color:var(--primary);">Beban Bulanan</th>
              <th style="<%= th %>text-align:right;color:var(--success);">Biaya Pemakaian Air</th>
              <th style="<%= th %>text-align:right;color:var(--muted);">Kubik (m³)</th>
              <th style="<%= th %>text-align:right;color:#8b5cf6;">Hibah / Donasi</th>
              <th style="<%= th %>text-align:right;color:var(--success);">Total Masuk</th>
            </tr>
          </thead>
          <tbody>
            <% tabelBulanan.forEach((row, idx) => { %>
            <tr style="border-bottom:1px solid rgba(255,255,255,.05);<%= !row.adaData ? 'opacity:.35;' : '' %>"
                onmouseover="this.style.background='rgba(255,255,255,.03)'" onmouseout="this.style.background=''">
              <td style="padding:11px 14px;color:var(--muted);font-size:12px;"><%= idx+1 %></td>
              <td style="padding:11px 14px;font-weight:600;white-space:nowrap;"><%= row.namaBulan %> <%= tahun %></td>
              <td style="padding:11px 14px;text-align:right;color:var(--primary);font-weight:600;">
                <%- row.bebanBulanan > 0 ? formatRupiah(row.bebanBulanan) : '<span style="color:var(--muted)">—</span>' %>
              </td>
              <td style="padding:11px 14px;text-align:right;color:var(--success);font-weight:600;">
                <%- row.biayaAir > 0 ? formatRupiah(row.biayaAir) : '<span style="color:var(--muted)">—</span>' %>
              </td>
              <td style="padding:11px 14px;text-align:right;color:var(--muted);">
                <%= row.kubik > 0 ? row.kubik.toLocaleString('id-ID',{maximumFractionDigits:2}) : '—' %>
              </td>
              <td style="padding:11px 14px;text-align:right;color:#8b5cf6;">
                <%- row.hibah > 0 ? formatRupiah(row.hibah) : '<span style="color:var(--muted)">—</span>' %>
              </td>
              <td style="padding:11px 14px;text-align:right;font-weight:700;color:var(--success);">
                <%- row.totalMasuk > 0 ? formatRupiah(row.totalMasuk) : '<span style="color:var(--muted)">—</span>' %>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr style="background:var(--sub-bg);border-top:2px solid var(--border);">
              <td colspan="2" style="padding:12px 14px;font-weight:800;color:var(--text);font-size:13px;">Total <%= tahun %></td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:var(--primary);"><%= formatRupiah(totBeban) %></td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:var(--success);"><%= formatRupiah(totAir) %></td>
              <td style="padding:12px 14px;text-align:right;font-weight:700;color:var(--muted);"><%= totKubik.toLocaleString('id-ID',{maximumFractionDigits:1}) %> m³</td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:#8b5cf6;"><%= formatRupiah(totHibah) %></td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:var(--success);"><%= formatRupiah(totMasuk) %></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Panel Pengeluaran per Dana -->
      <div id="panel-keluar" style="display:none;overflow-x:auto;padding:0;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
          <thead>
            <tr style="background:var(--sub-bg);">
              <th style="<%= th %>text-align:left;color:var(--muted);width:40px;">No</th>
              <th style="<%= th %>text-align:left;color:var(--muted);">Bulan</th>
              <th style="<%= th %>text-align:right;color:var(--primary);">Dari Abodemen</th>
              <th style="<%= th %>text-align:right;color:var(--success);">Dari Pemakaian Air</th>
              <th style="<%= th %>text-align:right;color:#8b5cf6;">Dari Hibah</th>
              <th style="<%= th %>text-align:right;color:var(--danger);">Total Keluar</th>
              <th style="<%= th %>text-align:right;color:var(--muted);">Saldo</th>
            </tr>
          </thead>
          <tbody>
            <% tabelBulanan.forEach((row, idx) => { %>
            <tr style="border-bottom:1px solid rgba(255,255,255,.05);<%= !row.adaData ? 'opacity:.35;' : '' %>"
                onmouseover="this.style.background='rgba(255,255,255,.03)'" onmouseout="this.style.background=''">
              <td style="padding:11px 14px;color:var(--muted);font-size:12px;"><%= idx+1 %></td>
              <td style="padding:11px 14px;font-weight:600;white-space:nowrap;"><%= row.namaBulan %> <%= tahun %></td>
              <td style="padding:11px 14px;text-align:right;color:var(--primary);">
                <%- row.keluarAbodemen > 0 ? formatRupiah(row.keluarAbodemen) : '<span style="color:var(--muted)">—</span>' %>
              </td>
              <td style="padding:11px 14px;text-align:right;color:var(--success);">
                <%- row.keluarAir > 0 ? formatRupiah(row.keluarAir) : '<span style="color:var(--muted)">—</span>' %>
              </td>
              <td style="padding:11px 14px;text-align:right;color:#8b5cf6;">
                <%- row.keluarHibah > 0 ? formatRupiah(row.keluarHibah) : '<span style="color:var(--muted)">—</span>' %>
              </td>
              <td style="padding:11px 14px;text-align:right;font-weight:700;color:var(--danger);">
                <%- row.pengeluaran > 0 ? formatRupiah(row.pengeluaran) : '<span style="color:var(--muted)">—</span>' %>
              </td>
              <td style="padding:11px 14px;text-align:right;font-weight:700;color:<%= row.saldo > 0 ? 'var(--success)' : row.saldo < 0 ? 'var(--danger)' : 'var(--muted)' %>;">
                <% if (row.adaData) { %><%= row.saldo < 0 ? '-' : '' %><%= formatRupiah(Math.abs(row.saldo)) %><% } else { %>—<% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr style="background:var(--sub-bg);border-top:2px solid var(--border);">
              <td colspan="2" style="padding:12px 14px;font-weight:800;color:var(--text);font-size:13px;">Total <%= tahun %></td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:var(--primary);"><%= formatRupiah(totKelAbodemen) %></td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:var(--success);"><%= formatRupiah(totKelAir) %></td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:#8b5cf6;"><%= formatRupiah(totKelHibah) %></td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:var(--danger);"><%= formatRupiah(totKeluar) %></td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:<%= totSaldo >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
                <%= totSaldo < 0 ? '-' : '' %><%= formatRupiah(Math.abs(totSaldo)) %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Panel Sisa Dana per Kategori -->
      <div id="panel-sisa" style="display:none;overflow-x:auto;padding:0;">
        <%
          let totSisaAbodemen=0, totSisaAir=0, totSisaHibah=0, totSisaTotal=0;
          tabelBulanan.forEach(r => {
            totSisaAbodemen += (r.bebanBulanan - r.keluarAbodemen);
            totSisaAir      += (r.biayaAir    - r.keluarAir);
            totSisaHibah    += (r.hibah        - r.keluarHibah);
            totSisaTotal    += r.saldo;
          });
        %>
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
          <thead>
            <tr style="background:var(--sub-bg);">
              <th style="<%= th %>text-align:left;color:var(--muted);width:40px;">No</th>
              <th style="<%= th %>text-align:left;color:var(--muted);">Bulan</th>
              <th style="<%= th %>text-align:right;color:var(--primary);">Sisa Abodemen</th>
              <th style="<%= th %>text-align:right;color:var(--success);">Sisa Pemakaian Air</th>
              <th style="<%= th %>text-align:right;color:#8b5cf6;">Sisa Hibah</th>
              <th style="<%= th %>text-align:right;color:var(--muted);">Total Sisa</th>
            </tr>
          </thead>
          <tbody>
            <% tabelBulanan.forEach((row, idx) => {
                const sisaAbodemen = row.bebanBulanan - row.keluarAbodemen;
                const sisaAir      = row.biayaAir    - row.keluarAir;
                const sisaHibah    = row.hibah        - row.keluarHibah;
                const sisaTotal    = sisaAbodemen + sisaAir + sisaHibah;
            %>
            <tr style="border-bottom:1px solid rgba(255,255,255,.05);<%= !row.adaData ? 'opacity:.35;' : '' %>"
                onmouseover="this.style.background='rgba(255,255,255,.03)'" onmouseout="this.style.background=''">
              <td style="padding:11px 14px;color:var(--muted);font-size:12px;"><%= idx+1 %></td>
              <td style="padding:11px 14px;font-weight:600;white-space:nowrap;"><%= row.namaBulan %> <%= tahun %></td>
              <td style="padding:11px 14px;text-align:right;font-weight:600;color:<%= sisaAbodemen >= 0 ? 'var(--primary)' : 'var(--danger)' %>;">
                <% if (!row.adaData && row.bebanBulanan === 0) { %>
                  <span style="color:var(--muted)">—</span>
                <% } else { %>
                  <%= sisaAbodemen < 0 ? '-' : '' %><%= formatRupiah(Math.abs(sisaAbodemen)) %>
                <% } %>
              </td>
              <td style="padding:11px 14px;text-align:right;font-weight:600;color:<%= sisaAir >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
                <% if (!row.adaData && row.biayaAir === 0) { %>
                  <span style="color:var(--muted)">—</span>
                <% } else { %>
                  <%= sisaAir < 0 ? '-' : '' %><%= formatRupiah(Math.abs(sisaAir)) %>
                <% } %>
              </td>
              <td style="padding:11px 14px;text-align:right;font-weight:600;color:<%= sisaHibah >= 0 ? '#8b5cf6' : 'var(--danger)' %>;">
                <% if (!row.adaData && row.hibah === 0) { %>
                  <span style="color:var(--muted)">—</span>
                <% } else { %>
                  <%= sisaHibah < 0 ? '-' : '' %><%= formatRupiah(Math.abs(sisaHibah)) %>
                <% } %>
              </td>
              <td style="padding:11px 14px;text-align:right;font-weight:800;color:<%= sisaTotal >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
                <% if (!row.adaData) { %>
                  <span style="color:var(--muted)">—</span>
                <% } else { %>
                  <%= sisaTotal < 0 ? '-' : '' %><%= formatRupiah(Math.abs(sisaTotal)) %>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr style="background:var(--sub-bg);border-top:2px solid var(--border);">
              <td colspan="2" style="padding:12px 14px;font-weight:800;color:var(--text);font-size:13px;">Total <%= tahun %></td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:<%= totSisaAbodemen >= 0 ? 'var(--primary)' : 'var(--danger)' %>;">
                <%= totSisaAbodemen < 0 ? '-' : '' %><%= formatRupiah(Math.abs(totSisaAbodemen)) %>
              </td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:<%= totSisaAir >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
                <%= totSisaAir < 0 ? '-' : '' %><%= formatRupiah(Math.abs(totSisaAir)) %>
              </td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:<%= totSisaHibah >= 0 ? '#8b5cf6' : 'var(--danger)' %>;">
                <%= totSisaHibah < 0 ? '-' : '' %><%= formatRupiah(Math.abs(totSisaHibah)) %>
              </td>
              <td style="padding:12px 14px;text-align:right;font-weight:800;color:<%= totSisaTotal >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
                <%= totSisaTotal < 0 ? '-' : '' %><%= formatRupiah(Math.abs(totSisaTotal)) %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

    </div><!-- end card -->

  </div>
</div>

<script>
const TAB_COLOR = { masuk: 'var(--success)', keluar: 'var(--danger)', sisa: '#8b5cf6' };
function switchTab(name) {
  ['masuk','keluar','sisa'].forEach(p => {
    document.getElementById('panel-' + p).style.display = p === name ? '' : 'none';
    const btn = document.getElementById('tab-' + p);
    btn.style.borderBottomColor = p === name ? TAB_COLOR[p] : 'transparent';
    btn.style.color             = p === name ? TAB_COLOR[p] : 'var(--muted)';
  });
}
switchTab('masuk');
</script>
</body>
</html>
