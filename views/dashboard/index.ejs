<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %><script src="https://cdn.jsdelivr.net/npm/chart.js"></script></head>
<body>
<%- include('../partials/sidebar') %>
<div class="main">
  <%- include('../partials/topbar', { pageTitle: 'Dashboard' }) %>
  <div class="content">
    <%- include('../partials/flash') %>

    <!-- Filter bulan/tahun -->
    <form method="GET" style="display:flex;gap:8px;align-items:center;margin-bottom:16px;flex-wrap:wrap;">
      <select name="bulan" class="form-control" style="width:auto;">
        <% ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'].forEach((b,i) => { %>
        <option value="<%= i+1 %>" <%=bulanFilter==i+1?'selected':''%>><%= b %></option>
        <% }) %>
      </select>
      <select name="tahun" class="form-control" style="width:auto;">
        <% for(let y = tahunIni; y >= tahunIni - 3; y--) { %>
        <option value="<%= y %>" <%=tahunFilter==y?'selected':''%>><%= y %></option>
        <% } %>
      </select>
      <button type="submit" class="btn btn-primary btn-sm">Tampilkan</button>
      <% if (bulanFilter != bulanIni || tahunFilter != tahunIni) { %>
      <a href="/dashboard" class="btn btn-secondary btn-sm">Bulan Ini</a>
      <% } %>
      <span style="font-size:12px;color:var(--muted);margin-left:4px;">
        Menampilkan data: <strong style="color:var(--text);">
          <%= ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'][bulanFilter-1] %> <%= tahunFilter %>
        </strong>
      </span>
    </form>

    <div class="stats-grid">
      <div class="stat-card blue">
        <div class="stat-label">Pelanggan Aktif</div>
        <div class="stat-value"><%= totalPelangganAktif %></div>
        <div class="stat-sub"><%= totalPelangganNonaktif %> nonaktif</div>
      </div>
      <div class="stat-card green">
        <div class="stat-label">Total Tagihan Bulan Ini</div>
        <div class="stat-value" style="font-size:18px"><%= formatRupiah(totalTagihanBulanIni) %></div>
        <div class="stat-sub">Lunas: <%= formatRupiah(totalLunasBulanIni) %></div>
      </div>
      <div class="stat-card red">
        <div class="stat-label">Total Tunggakan</div>
        <div class="stat-value" style="font-size:18px"><%= formatRupiah(totalTunggakan) %></div>
        <div class="stat-sub"><%= pelangganMenunggak %> pelanggan</div>
      </div>
      <div class="stat-card orange">
        <div class="stat-label">Pengaduan Baru</div>
        <div class="stat-value"><%= pengaduanBaru %></div>
        <div class="stat-sub"><%= pengaduanBelumSelesai %> belum selesai</div>
      </div>
    </div>

    <!-- Komposisi Tagihan Bulan Ini -->
    <% if (totalTagihanBulanIni > 0) { %>
    <div class="card" style="margin-bottom:16px;padding:16px;">
      <div class="card-header" style="margin-bottom:14px;">
        <span class="card-title">Komposisi Tagihan Bulan Ini</span>
        <span style="font-size:12px;color:var(--muted);">Total: <strong style="color:var(--text);"><%= formatRupiah(totalTagihanBulanIni) %></strong></span>
      </div>
      <!-- Total Kubik -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
        <div style="background:var(--sub-bg);border-radius:10px;padding:12px 16px;display:flex;align-items:center;gap:12px;">
          <div style="font-size:26px;line-height:1;">💧</div>
          <div>
            <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;">Pemakaian Air Bulan Ini</div>
            <div style="font-size:20px;font-weight:800;color:var(--primary);"><%= kubikBulanIni.toLocaleString('id-ID', {maximumFractionDigits:2}) %> <span style="font-size:13px;font-weight:500;color:var(--muted);">m³</span></div>
          </div>
        </div>
        <div style="background:var(--sub-bg);border-radius:10px;padding:12px 16px;display:flex;align-items:center;gap:12px;">
          <div style="font-size:26px;line-height:1;">🌊</div>
          <div>
            <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;">Rata-rata per Pelanggan</div>
            <div style="font-size:20px;font-weight:800;color:var(--secondary);"><%= totalPelangganAktif > 0 ? (kubikBulanIni / totalPelangganAktif).toLocaleString('id-ID', {maximumFractionDigits:2}) : '0' %> <span style="font-size:13px;font-weight:500;color:var(--muted);">m³</span></div>
          </div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <!-- Beban Bulanan -->
        <div>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
            <div>
              <div style="font-size:13px;font-weight:600;">Beban Bulanan</div>
              <div style="font-size:11px;color:var(--muted);">biaya admin / abodemen tetap</div>
            </div>
            <div style="text-align:right;">
              <div style="font-size:16px;font-weight:700;color:var(--primary);"><%= formatRupiah(bebanBulananBulanIni) %></div>
              <div style="font-size:11px;color:var(--muted);"><%= totalTagihanBulanIni > 0 ? Math.round(bebanBulananBulanIni / totalTagihanBulanIni * 100) : 0 %>%</div>
            </div>
          </div>
          <div style="background:var(--sub-bg);border-radius:4px;height:8px;overflow:hidden;">
            <div style="background:var(--primary);height:100%;border-radius:4px;width:<%= totalTagihanBulanIni > 0 ? Math.round(bebanBulananBulanIni / totalTagihanBulanIni * 100) : 0 %>%;"></div>
          </div>
        </div>
        <!-- Biaya Pemakaian Air -->
        <div>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
            <div>
              <div style="font-size:13px;font-weight:600;">Biaya Pemakaian Air</div>
              <div style="font-size:11px;color:var(--muted);">pemakaian m³ × harga tarif</div>
            </div>
            <div style="text-align:right;">
              <div style="font-size:16px;font-weight:700;color:var(--success);"><%= formatRupiah(pemakaianAirBulanIni) %></div>
              <div style="font-size:11px;color:var(--muted);"><%= totalTagihanBulanIni > 0 ? Math.round(pemakaianAirBulanIni / totalTagihanBulanIni * 100) : 0 %>%</div>
            </div>
          </div>
          <div style="background:var(--sub-bg);border-radius:4px;height:8px;overflow:hidden;">
            <div style="background:var(--success);height:100%;border-radius:4px;width:<%= totalTagihanBulanIni > 0 ? Math.round(pemakaianAirBulanIni / totalTagihanBulanIni * 100) : 0 %>%;"></div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Ringkasan Keuangan -->
    <div style="display:grid;grid-template-columns:repeat(<%= hibahBulanIni > 0 ? 4 : 3 %>,1fr);gap:12px;margin-bottom:16px;">
      <div class="card" style="padding:16px;border-left:4px solid var(--success);">
        <div style="font-size:12px;color:var(--muted);margin-bottom:4px;">Biaya Pemakaian Air</div>
        <div style="font-size:18px;font-weight:700;color:var(--success);"><%= formatRupiah(iuranAirBulan) %></div>
        <div style="font-size:11px;color:var(--muted);margin-top:2px;">iuran air dari pelanggan</div>
      </div>
      <% if (hibahBulanIni > 0) { %>
      <div class="card" style="padding:16px;border-left:4px solid var(--primary);">
        <div style="font-size:12px;color:var(--muted);margin-bottom:4px;">Pemasukan Lain</div>
        <div style="font-size:18px;font-weight:700;color:var(--primary);"><%= formatRupiah(hibahBulanIni) %></div>
        <div style="font-size:11px;color:var(--muted);margin-top:2px;"><a href="/pemasukan" style="color:var(--primary);">hibah / donasi</a></div>
      </div>
      <% } %>
      <div class="card" style="padding:16px;border-left:4px solid var(--danger);">
        <div style="font-size:12px;color:var(--muted);margin-bottom:4px;">Beban Operasional</div>
        <div style="font-size:18px;font-weight:700;color:var(--danger);"><%= formatRupiah(bebanBulan) %></div>
        <div style="font-size:11px;color:var(--muted);margin-top:2px;"><a href="/pengeluaran" style="color:var(--primary);">Lihat detail</a></div>
      </div>
      <div class="card" style="padding:16px;border-left:4px solid <%= saldoBulanIni >= 0 ? 'var(--primary)' : 'var(--warning)' %>;">
        <div style="font-size:12px;color:var(--muted);margin-bottom:4px;">Saldo Bulan Ini</div>
        <div style="font-size:18px;font-weight:700;color:<%= saldoBulanIni >= 0 ? 'var(--primary)' : 'var(--warning)' %>;"><%= formatRupiah(Math.abs(saldoBulanIni)) %></div>
        <div style="font-size:11px;color:var(--muted);margin-top:2px;"><%= saldoBulanIni >= 0 ? 'Surplus' : 'Defisit' %></div>
      </div>
    </div>

    <!-- Neraca Keseluruhan -->
    <div class="card" style="margin-bottom:16px;padding:16px;">
      <div class="card-header" style="margin-bottom:12px;"><span class="card-title">Neraca Keuangan Keseluruhan</span></div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:16px;align-items:center;">
        <div>
          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Biaya Pemakaian Air</div>
          <div style="font-size:18px;font-weight:700;color:var(--success);"><%= formatRupiah(iuranAirTotal) %></div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px;">iuran air pelanggan</div>
        </div>
        <div>
          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Pemasukan Lain</div>
          <div style="font-size:18px;font-weight:700;color:var(--primary);"><%= formatRupiah(hibahTotal) %></div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px;">hibah / donasi</div>
        </div>
        <div>
          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Total Beban</div>
          <div style="font-size:18px;font-weight:700;color:var(--danger);"><%= formatRupiah(bebanTotal) %></div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px;">pengeluaran operasional</div>
        </div>
        <div style="background:var(--sub-bg);border-radius:10px;padding:14px;text-align:center;">
          <div style="font-size:12px;color:var(--muted);">Saldo Bersih</div>
          <div style="font-size:22px;font-weight:800;color:<%= saldoTotal >= 0 ? 'var(--success)' : 'var(--danger)' %>;"><%= formatRupiah(Math.abs(saldoTotal)) %></div>
          <div style="font-size:12px;font-weight:600;color:<%= saldoTotal >= 0 ? 'var(--success)' : 'var(--danger)' %>;"><%= saldoTotal >= 0 ? '▲ Surplus' : '▼ Defisit' %></div>
        </div>
      </div>
    </div>

    <!-- Charts 2 kolom -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
      <div class="card">
        <div class="card-header">
          <span class="card-title">Tren Tagihan &amp; Pembayaran 6 Bulan</span>
        </div>
        <canvas id="chartTagihan" height="120"></canvas>
      </div>
      <div class="card">
        <div class="card-header">
          <span class="card-title">Tren Pemakaian Air 6 Bulan (m&#179;)</span>
        </div>
        <canvas id="chartKubik" height="120"></canvas>
      </div>
    </div>
  </div>
</div>
<script>
const data = <%- chartData %>;

new Chart(document.getElementById('chartTagihan').getContext('2d'), {
  type: 'bar',
  data: {
    labels: data.map(d => d.label),
    datasets: [
      { label: 'Total Tagihan',        data: data.map(d => d.total),  backgroundColor: 'rgba(14,165,233,.25)', borderColor: '#0EA5E9', borderWidth: 2, borderRadius: 6 },
      { label: 'Terbayar (Pemasukan)', data: data.map(d => d.lunas),  backgroundColor: 'rgba(16,185,129,.25)', borderColor: '#10B981', borderWidth: 2, borderRadius: 6 },
      { label: 'Pengeluaran',          data: data.map(d => d.keluar), backgroundColor: 'rgba(239,68,68,.25)',  borderColor: '#EF4444', borderWidth: 2, borderRadius: 6 },
    ],
  },
  options: {
    responsive: true, interaction: { mode: 'index' },
    plugins: { legend: { labels: { color: '#94A3B8', font: { family: 'Outfit' } } } },
    scales: {
      x: { ticks: { color: '#94A3B8' }, grid: { color: 'rgba(255,255,255,.05)' } },
      y: { ticks: { color: '#94A3B8', callback: v => 'Rp ' + (v/1000).toFixed(0) + 'k' }, grid: { color: 'rgba(255,255,255,.05)' } },
    },
  },
});

new Chart(document.getElementById('chartKubik').getContext('2d'), {
  type: 'line',
  data: {
    labels: data.map(d => d.label),
    datasets: [{
      label: 'Pemakaian Air (m³)',
      data: data.map(d => d.kubik),
      backgroundColor: 'rgba(14,165,233,.15)',
      borderColor: '#0EA5E9',
      borderWidth: 2,
      pointBackgroundColor: '#0EA5E9',
      pointRadius: 4,
      fill: true,
      tension: 0.4,
    }],
  },
  options: {
    responsive: true, interaction: { mode: 'index' },
    plugins: { legend: { labels: { color: '#94A3B8', font: { family: 'Outfit' } } } },
    scales: {
      x: { ticks: { color: '#94A3B8' }, grid: { color: 'rgba(255,255,255,.05)' } },
      y: { beginAtZero: true, ticks: { color: '#94A3B8', callback: v => v.toLocaleString('id') + ' m³' }, grid: { color: 'rgba(255,255,255,.05)' } },
    },
  },
});
</script>
</body>
</html>
