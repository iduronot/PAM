<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body>
<% if (typeof user !== 'undefined' && user) { %>
<%- include('partials/sidebar') %>
<div class="main">
  <%- include('partials/topbar', { pageTitle: 'Error' }) %>
  <div class="content">
    <div style="text-align:center;padding:60px 20px;">
      <div style="font-size:60px;margin-bottom:16px;">⚠️</div>
      <h2 style="font-size:20px;font-weight:700;margin-bottom:8px;"><%= typeof message !== 'undefined' ? message : 'Terjadi Kesalahan' %></h2>
      <p style="color:var(--muted);font-size:14px;margin-bottom:24px;">Halaman yang Anda cari tidak ditemukan atau Anda tidak memiliki akses.</p>
      <a href="/" class="btn btn-primary">Kembali ke Beranda</a>
    </div>
  </div>
</div>
<% } else { %>
<div style="display:flex;align-items:center;justify-content:center;min-height:100vh;text-align:center;flex-direction:column;">
  <div style="font-size:60px;margin-bottom:16px;">⚠️</div>
  <h2><%= typeof message !== 'undefined' ? message : 'Error' %></h2>
  <a href="/login" class="btn btn-primary" style="margin-top:16px;">Login</a>
</div>
<% } %>
</body>
</html>
