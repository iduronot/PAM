<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/sidebar') %>
<div class="main">
  <%- include('../partials/topbar', { pageTitle: 'Pemasukan Lain' }) %>
  <div class="content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <h1 class="page-title">Pemasukan Lain-lain</h1>
      <% if (['super_admin','admin_pam'].includes(user.role)) { %>
      <a href="/pemasukan/tambah" class="btn btn-primary">+ Tambah Pemasukan</a>
      <% } %>
    </div>

    <!-- Summary cards -->
    <div class="stats-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:20px;">
      <div class="stat-card green">
        <div class="stat-label">Total Pemasukan (filter)</div>
        <div class="stat-value" style="font-size:20px;"><%= formatRupiah(totalJumlah) %></div>
      </div>
      <div class="stat-card blue">
        <div class="stat-label">Jumlah Transaksi</div>
        <div class="stat-value"><%= count %></div>
      </div>
      <div class="stat-card teal">
        <div class="stat-label">Rata-rata / Transaksi</div>
        <div class="stat-value" style="font-size:18px;"><%= count > 0 ? formatRupiah(Math.round(totalJumlah / count)) : 'Rp 0' %></div>
      </div>
    </div>

    <div class="card">
      <form method="GET" class="search-bar" style="margin-bottom:16px;">
        <input name="q" class="search-input" placeholder="Cari no, sumber, keterangan..." value="<%= q||'' %>">
        <select name="kategori" class="form-control" style="width:auto;">
          <option value="">Semua Kategori</option>
          <% Object.entries(LABEL_KATEGORI).forEach(([k,v]) => { %>
          <option value="<%= k %>" <%=kategori===k?'selected':''%>><%= v %></option>
          <% }) %>
        </select>
        <input type="date" name="dari" class="form-control" style="width:auto;" value="<%= dari||'' %>" title="Dari tanggal">
        <input type="date" name="sampai" class="form-control" style="width:auto;" value="<%= sampai||'' %>" title="Sampai tanggal">
        <button type="submit" class="btn btn-primary btn-sm">Cari</button>
        <% if (q||kategori||dari||sampai) { %><a href="/pemasukan" class="btn btn-secondary btn-sm">Reset</a><% } %>
      </form>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th style="width:40px;">No</th>
              <th>No. Pemasukan</th>
              <th>Tanggal</th>
              <th>Kategori</th>
              <th>Sumber</th>
              <th>Keterangan</th>
              <th>Jumlah</th>
              <th>Metode</th>
              <th>Pencatat</th>
              <% if (['super_admin','admin_pam'].includes(user.role)) { %><th>Aksi</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% if (list.length === 0) { %>
            <tr><td colspan="10" style="text-align:center;color:var(--muted);padding:40px;">Belum ada data pemasukan</td></tr>
            <% } %>
            <% list.forEach((item, i) => { %>
            <tr>
              <td style="color:var(--muted);font-size:12px;"><%= (page-1)*limit + i + 1 %></td>
              <td><span style="font-weight:600;color:var(--primary);font-size:12px;"><%= item.no_pemasukan %></span></td>
              <td style="white-space:nowrap;"><%= formatTanggal(item.tanggal) %></td>
              <td>
                <%
                  const badge = { hibah_desa:'info', hibah_kecamatan:'purple', hibah_pemerintah:'warning',
                                  donasi:'success', retribusi:'teal', lain_lain:'muted' };
                %>
                <span class="badge badge-<%= badge[item.kategori]||'muted' %>" style="font-size:10px;">
                  <%= LABEL_KATEGORI[item.kategori] || item.kategori %>
                </span>
              </td>
              <td style="font-weight:600;"><%= item.sumber %></td>
              <td style="color:var(--muted);font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= item.keterangan||'' %>">
                <%= item.keterangan || '-' %>
              </td>
              <td style="font-weight:700;color:var(--success);white-space:nowrap;"><%= formatRupiah(item.jumlah) %></td>
              <td>
                <span class="badge badge-<%= item.metode_terima==='transfer'?'info':'muted' %>" style="font-size:10px;">
                  <%= item.metode_terima === 'transfer' ? 'Transfer' : 'Tunai' %>
                </span>
              </td>
              <td style="font-size:12px;color:var(--muted);"><%= item.pencatat ? item.pencatat.nama : '-' %></td>
              <% if (['super_admin','admin_pam'].includes(user.role)) { %>
              <td style="white-space:nowrap;display:flex;gap:4px;">
                <a href="/pemasukan/<%= item.id %>/edit" class="btn btn-secondary btn-xs">Edit</a>
                <form method="POST" action="/pemasukan/<%= item.id %>/hapus" onsubmit="return confirm('Hapus pemasukan ini?')">
                  <button type="submit" class="btn btn-danger btn-xs">Hapus</button>
                </form>
              </td>
              <% } %>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (totalPages > 1) { %>
      <div class="pagination">
        <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>&q=<%= q||'' %>&kategori=<%= kategori||'' %>&dari=<%= dari||'' %>&sampai=<%= sampai||'' %>" class="page-btn <%= i===page?'active':'' %>"><%= i %></a>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>
