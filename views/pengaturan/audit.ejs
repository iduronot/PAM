<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/sidebar') %>
<div class="main">
  <%- include('../partials/topbar', { pageTitle: 'Audit Log' }) %>
  <div class="content">
    <div class="page-header"><h1 class="page-title">Audit Log (200 terakhir)</h1><a href="/pengaturan" class="btn btn-secondary">Kembali</a></div>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Waktu</th><th>User</th><th>Aksi</th><th>Tabel</th><th>Record</th><th>Keterangan</th></tr></thead>
          <tbody>
            <% logList.forEach(l => { %>
            <tr>
              <td style="white-space:nowrap;font-size:11px;color:var(--muted);"><%= formatTanggal(l.createdAt) %></td>
              <td style="font-size:12px;"><%= l.user ? l.user.nama : 'System' %></td>
              <td><span class="badge badge-info" style="font-size:10px;"><%= l.aksi %></span></td>
              <td style="font-size:12px;color:var(--muted);"><%= l.tabel_nama || '-' %></td>
              <td style="font-size:12px;"><%= l.record_id || '-' %></td>
              <td style="font-size:12px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= l.keterangan || '-' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</body>
</html>
