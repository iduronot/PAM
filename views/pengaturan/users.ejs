<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/sidebar') %>
<div class="main">
  <%- include('../partials/topbar', { pageTitle: 'Manajemen User' }) %>
  <div class="content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <h1 class="page-title">Manajemen User</h1>
      <div style="display:flex;gap:8px;">
        <a href="/pengaturan/users/tambah" class="btn btn-primary">+ Tambah User</a>
        <a href="/pengaturan" class="btn btn-secondary">Kembali</a>
      </div>
    </div>
    <div class="card">
      <form method="GET" class="search-bar">
        <input name="q" class="search-input" placeholder="Cari nama, username, atau email..." value="<%= q || '' %>">
        <select name="role" class="form-control" style="width:auto;">
          <option value="">Semua Role</option>
          <option value="super_admin" <%=role==='super_admin'?'selected':''%>>Super Admin</option>
          <option value="admin_pam" <%=role==='admin_pam'?'selected':''%>>Admin PAM</option>
          <option value="manajer" <%=role==='manajer'?'selected':''%>>Manajer</option>
          <option value="kasir" <%=role==='kasir'?'selected':''%>>Kasir</option>
          <option value="petugas_meter" <%=role==='petugas_meter'?'selected':''%>>Petugas Meter</option>
          <option value="pelanggan" <%=role==='pelanggan'?'selected':''%>>Pelanggan</option>
        </select>
        <select name="is_active" class="form-control" style="width:auto;">
          <option value="">Semua Status</option>
          <option value="1" <%=is_active==='1'?'selected':''%>>Aktif</option>
          <option value="0" <%=is_active==='0'?'selected':''%>>Nonaktif</option>
        </select>
        <button type="submit" class="btn btn-primary">Cari</button>
        <a href="/pengaturan/users" class="btn btn-secondary">Reset</a>
      </form>
      <div class="table-wrap">
        <table>
          <thead><tr><th style="width:40px;">No</th><th>Nama</th><th>Username</th><th>Email</th><th>Role</th><th>Status</th><th>Aksi</th></tr></thead>
          <tbody>
            <% userList.forEach((u, i) => { %>
            <tr>
              <td style="color:var(--muted);font-size:12px;"><%= (page-1)*limit + i + 1 %></td>
              <td><strong><%= u.nama %></strong></td>
              <td><%= u.username %></td>
              <td><%= u.email || '-' %></td>
              <td>
                <% const rm = { super_admin: 'danger', admin_pam: 'warning', manajer: 'purple', kasir: 'info', petugas_meter: 'teal', pelanggan: 'muted' }; %>
                <span class="badge badge-<%= rm[u.role] || 'muted' %>"><%= u.role.replace(/_/g,' ') %></span>
              </td>
              <td><span class="badge badge-<%= u.is_active ? 'success' : 'danger' %>"><%= u.is_active ? 'Aktif' : 'Nonaktif' %></span></td>
              <td style="display:flex;gap:4px;flex-wrap:wrap;">
                <a href="/pengaturan/users/<%= u.id %>/edit" class="btn btn-secondary btn-xs">Edit</a>
                <button type="button" class="btn btn-xs" style="background:rgba(245,158,11,.12);color:var(--warning);border:1px solid rgba(245,158,11,.25);" onclick="openPasswordModal(<%= u.id %>, '<%= u.nama.replace(/'/g, "\\'") %>')">Ubah Password</button>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (totalPages > 1) { %>
      <div class="pagination">
        <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>&q=<%= q||'' %>&role=<%= role||'' %>&is_active=<%= is_active||'' %>" class="page-btn <%= i === page ? 'active' : '' %>"><%= i %></a>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal Ubah Password -->
<div id="passwordModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:2000;align-items:center;justify-content:center;">
  <div style="background:var(--modal-bg);border:1px solid var(--border);border-radius:16px;padding:28px;width:100%;max-width:400px;margin:16px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
      <div>
        <h2 style="font-size:16px;font-weight:700;">Ubah Password</h2>
        <p id="modalUserName" style="font-size:12px;color:var(--muted);margin-top:2px;"></p>
      </div>
      <button type="button" onclick="closePasswordModal()" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:20px;line-height:1;">&times;</button>
    </div>
    <form id="passwordForm" method="POST" action="">
      <div class="form-group">
        <label class="form-label">Password Baru</label>
        <input type="password" name="password_baru" id="passwordBaru" class="form-control" placeholder="Masukkan password baru" autocomplete="new-password" required>
      </div>
      <div class="form-group">
        <label class="form-label">Konfirmasi Password</label>
        <input type="password" name="password_konfirm" id="passwordKonfirm" class="form-control" placeholder="Ulangi password baru" autocomplete="new-password" required>
        <small id="matchHint" style="font-size:11px;margin-top:4px;display:block;"></small>
      </div>
      <div style="display:flex;gap:8px;margin-top:4px;">
        <button type="submit" class="btn btn-primary" style="flex:1;">Simpan Password</button>
        <button type="button" onclick="closePasswordModal()" class="btn btn-secondary">Batal</button>
      </div>
    </form>
  </div>
</div>

<script>
function openPasswordModal(userId, userName) {
  document.getElementById('passwordForm').action = '/pengaturan/users/' + userId + '/ganti-password';
  document.getElementById('modalUserName').textContent = userName;
  document.getElementById('passwordBaru').value = '';
  document.getElementById('passwordKonfirm').value = '';
  document.getElementById('matchHint').textContent = '';
  document.getElementById('passwordModal').style.display = 'flex';
  setTimeout(() => document.getElementById('passwordBaru').focus(), 100);
}
function closePasswordModal() {
  document.getElementById('passwordModal').style.display = 'none';
}
document.getElementById('passwordModal').addEventListener('click', function(e) {
  if (e.target === this) closePasswordModal();
});
document.getElementById('passwordKonfirm').addEventListener('input', function() {
  const baru = document.getElementById('passwordBaru').value;
  const hint = document.getElementById('matchHint');
  if (!this.value) { hint.textContent = ''; return; }
  if (this.value === baru) {
    hint.textContent = 'Password cocok ✓';
    hint.style.color = 'var(--success)';
  } else {
    hint.textContent = 'Password tidak cocok';
    hint.style.color = 'var(--danger)';
  }
});
document.getElementById('passwordForm').addEventListener('submit', function(e) {
  const baru = document.getElementById('passwordBaru').value;
  const konfirm = document.getElementById('passwordKonfirm').value;
  if (!baru) { e.preventDefault(); alert('Password tidak boleh kosong'); return; }
  if (baru !== konfirm) { e.preventDefault(); alert('Password tidak cocok'); return; }
});
</script>
</div>
</body>
</html>
