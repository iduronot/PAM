<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head') %>
  <style>
    @media print {
      .no-print { display: none !important; }
      .main { margin-left: 0 !important; }
      .sidebar, .topbar { display: none !important; }
      .receipt-wrap { max-width: 100%; padding: 0; }
    }
  </style>
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="main">
  <%- include('../partials/topbar', { pageTitle: 'Bukti Pembayaran' }) %>
  <div class="content">
    <div class="page-header no-print">
      <h1 class="page-title">Bukti Pembayaran</h1>
      <div style="display:flex;gap:8px;">
        <button onclick="window.print()" class="btn btn-primary">🖨️ Cetak</button>
        <a href="/pembayaran" class="btn btn-secondary">Kembali</a>
      </div>
    </div>

    <div class="card receipt-wrap" style="max-width:520px;">
      <div style="text-align:center;margin-bottom:20px;padding-bottom:16px;border-bottom:2px dashed var(--border);">
        <div style="font-size:28px;margin-bottom:6px;">💧</div>
        <h2 style="font-size:18px;font-weight:700;margin:0;"><%= APP_NAME || 'PAMSIMAS' %></h2>
        <p style="font-size:13px;color:var(--muted);margin:4px 0 0;">Bukti Pembayaran Air Minum</p>
      </div>

      <table style="font-size:13px;">
        <tr><td style="color:var(--muted);padding:6px 0;width:150px;">No. Pembayaran</td><td><strong><%= pembayaran.no_pembayaran %></strong></td></tr>
        <tr><td style="color:var(--muted);padding:6px 0;">Tanggal Bayar</td><td><%= formatTanggal(pembayaran.tanggal_bayar) %></td></tr>
        <tr><td style="color:var(--muted);padding:6px 0;">No. Pelanggan</td><td><%= pembayaran.pelanggan ? pembayaran.pelanggan.no_pelanggan : '-' %></td></tr>
        <tr><td style="color:var(--muted);padding:6px 0;">Nama</td><td><strong><%= pembayaran.pelanggan ? pembayaran.pelanggan.nama : '-' %></strong></td></tr>
        <tr><td style="color:var(--muted);padding:6px 0;">Alamat</td><td><%= pembayaran.pelanggan ? pembayaran.pelanggan.alamat : '-' %></td></tr>
        <tr><td style="color:var(--muted);padding:6px 0;">No. Tagihan</td><td><%= pembayaran.tagihan ? pembayaran.tagihan.no_tagihan : '-' %></td></tr>
        <tr><td style="color:var(--muted);padding:6px 0;">Pemakaian</td><td><%= pembayaran.tagihan ? pembayaran.tagihan.pemakaian + ' m³' : '-' %></td></tr>
        <tr><td style="color:var(--muted);padding:6px 0;">Metode Bayar</td><td><%= pembayaran.metode %></td></tr>
        <tr><td style="color:var(--muted);padding:6px 0;">Kasir</td><td><%= pembayaran.kasir ? pembayaran.kasir.nama : '-' %></td></tr>
      </table>

      <div style="background:linear-gradient(135deg,rgba(16,185,129,.15),rgba(14,165,233,.1));border:1px solid rgba(16,185,129,.3);border-radius:12px;padding:16px;margin:16px 0;text-align:center;">
        <div style="font-size:12px;color:var(--muted);margin-bottom:4px;">Jumlah Dibayar</div>
        <div style="font-size:32px;font-weight:800;color:var(--success);"><%= formatRupiah(pembayaran.jumlah_bayar) %></div>
        <div style="font-size:12px;color:var(--success);margin-top:4px;">✓ LUNAS</div>
      </div>

      <% if (pembayaran.catatan) { %>
      <p style="font-size:12px;color:var(--muted);">Catatan: <%= pembayaran.catatan %></p>
      <% } %>

      <div style="text-align:center;font-size:11px;color:var(--muted);margin-top:16px;padding-top:16px;border-top:2px dashed var(--border);">
        Terima kasih telah membayar tagihan air tepat waktu<br>
        Simpan bukti ini sebagai tanda pembayaran yang sah
      </div>
    </div>
  </div>
</div>
</body>
</html>
