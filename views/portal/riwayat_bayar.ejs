<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/sidebar') %>
<div class="main">
  <%- include('../partials/topbar', { pageTitle: 'Riwayat Pembayaran' }) %>
  <div class="content">
    <div class="page-header"><h1 class="page-title">Riwayat Pembayaran</h1><a href="/pelanggan-portal" class="btn btn-secondary">Kembali</a></div>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead><tr><th>No. Pembayaran</th><th>Tagihan</th><th>Tanggal Bayar</th><th>Jumlah</th><th>Metode</th></tr></thead>
          <tbody>
            <% if (pembayaranList.length === 0) { %><tr><td colspan="5" style="text-align:center;color:var(--muted);padding:32px;">Belum ada riwayat pembayaran</td></tr><% } %>
            <% pembayaranList.forEach(p => { %>
            <tr>
              <td><small><%= p.no_pembayaran %></small></td>
              <td><small><%= p.tagihan ? p.tagihan.no_tagihan : '-' %></small></td>
              <td><%= formatTanggal(p.tanggal_bayar) %></td>
              <td><strong style="color:var(--success);"><%= formatRupiah(p.jumlah_bayar) %></strong></td>
              <td><span class="badge badge-info"><%= p.metode %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</body>
</html>
