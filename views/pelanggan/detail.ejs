<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/sidebar') %>
<div class="main">
  <%- include('../partials/topbar', { pageTitle: 'Detail Pelanggan' }) %>
  <div class="content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <h1 class="page-title"><%= pelanggan.nama %> <span style="font-size:14px;color:var(--muted);">(<%= pelanggan.no_pelanggan %>)</span></h1>
      <div style="display:flex;gap:8px;">
        <% if (['super_admin','admin_pam'].includes(user.role)) { %>
        <a href="/pelanggan/<%= pelanggan.id %>/edit" class="btn btn-primary btn-sm">Edit</a>
        <% } %>
        <a href="/pelanggan" class="btn btn-secondary btn-sm">Kembali</a>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
      <div class="card">
        <div class="card-header"><span class="card-title">Informasi Pelanggan</span></div>
        <table>
          <tr><td style="color:var(--muted);width:140px;">No. Pelanggan</td><td><strong><%= pelanggan.no_pelanggan %></strong></td></tr>
          <tr><td style="color:var(--muted);">No. Sambungan</td><td><%= pelanggan.no_sambungan %></td></tr>
          <tr><td style="color:var(--muted);">Nama</td><td><strong><%= pelanggan.nama %></strong></td></tr>
          <tr><td style="color:var(--muted);">NIK</td><td><%= pelanggan.nik || '-' %></td></tr>
          <tr><td style="color:var(--muted);">No HP</td><td><%= pelanggan.no_hp || '-' %></td></tr>
          <tr><td style="color:var(--muted);">Email</td><td><%= pelanggan.email || '-' %></td></tr>
          <tr><td style="color:var(--muted);">Alamat</td><td><%= pelanggan.alamat %><% if (pelanggan.rt_rw) { %>, RT/RW <%= pelanggan.rt_rw %><% } %><% if (pelanggan.kelurahan) { %>, <%= pelanggan.kelurahan %><% } %><% if (pelanggan.kecamatan) { %>, Kec. <%= pelanggan.kecamatan %><% } %></td></tr>
          <tr><td style="color:var(--muted);">Kategori</td><td><%= pelanggan.kategori ? pelanggan.kategori.nama : '-' %></td></tr>
          <tr><td style="color:var(--muted);">Rute</td><td><%= pelanggan.rute ? pelanggan.rute.nama_rute : '-' %></td></tr>
          <tr><td style="color:var(--muted);">Tgl Daftar</td><td><%= formatTanggal(pelanggan.tanggal_daftar) %></td></tr>
          <tr><td style="color:var(--muted);">Status</td><td>
            <% const sm = { aktif: 'success', nonaktif: 'muted', putus_sementara: 'warning', putus_permanen: 'danger' }; %>
            <span class="badge badge-<%= sm[pelanggan.status] %>"><%= pelanggan.status.replace(/_/g,' ') %></span>
          </td></tr>
          <% if (pelanggan.catatan) { %><tr><td style="color:var(--muted);">Catatan</td><td><%= pelanggan.catatan %></td></tr><% } %>
        </table>

        <% if (['super_admin','admin_pam'].includes(user.role)) { %>
        <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);">
          <form method="POST" action="/pelanggan/<%= pelanggan.id %>/status" style="display:flex;gap:8px;align-items:center;">
            <select name="status" class="form-control" style="width:auto;">
              <option value="aktif">Aktif</option>
              <option value="nonaktif">Nonaktif</option>
              <option value="putus_sementara">Putus Sementara</option>
              <option value="putus_permanen">Putus Permanen</option>
            </select>
            <button type="submit" class="btn btn-secondary btn-sm">Ubah Status</button>
          </form>
        </div>
        <% } %>
      </div>

      <div>
        <!-- Meter -->
        <div class="card" style="margin-bottom:16px;">
          <div class="card-header">
            <span class="card-title">Data Meter (<%= pelanggan.meter ? pelanggan.meter.length : 0 %>)</span>
            <% if (['super_admin','admin_pam'].includes(user.role)) { %>
            <a href="/meter/tambah?pelanggan_id=<%= pelanggan.id %>" class="btn btn-primary btn-xs">+ Tambah Meter</a>
            <% } %>
          </div>
          <% if (pelanggan.meter && pelanggan.meter.length > 0) { %>
            <% pelanggan.meter.forEach(m => { %>
            <div style="padding:10px;background:var(--sub-bg);border-radius:8px;margin-bottom:8px;">
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <strong style="font-size:13px;"><%= m.no_meter %></strong>
                <span class="badge badge-<%= m.status === 'aktif' ? 'success' : 'muted' %>"><%= m.status %></span>
              </div>
              <div style="font-size:12px;color:var(--muted);margin-top:4px;">
                Dipasang: <%= formatTanggal(m.tanggal_pasang) %> &bull; Angka awal: <%= m.angka_awal %> m³
                <% if (m.merk) { %>&bull; <%= m.merk %><% } %>
              </div>
            </div>
            <% }) %>
          <% } else { %>
            <p style="color:var(--muted);font-size:13px;">Belum ada meter terdaftar</p>
          <% } %>
        </div>

        <!-- Tagihan terbuka -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">Tagihan Belum Lunas</span>
            <a href="/tagihan?pelanggan_id=<%= pelanggan.id %>" class="btn btn-secondary btn-xs">Lihat Semua</a>
          </div>
          <% if (tagihanTerbuka.length > 0) { %>
            <% tagihanTerbuka.forEach(t => { %>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:10px;background:var(--sub-bg);border-radius:8px;margin-bottom:8px;">
              <div>
                <div style="font-size:13px;font-weight:600;"><%= t.no_tagihan %></div>
                <div style="font-size:11px;color:var(--muted);">Jatuh tempo: <%= formatTanggal(t.tanggal_jatuh_tempo) %></div>
              </div>
              <div style="text-align:right;">
                <div style="font-weight:700;color:var(--warning);"><%= formatRupiah(t.total_tagihan) %></div>
                <a href="/pembayaran/catat?tagihan_id=<%= t.id %>" class="btn btn-success btn-xs" style="margin-top:4px;">Bayar</a>
              </div>
            </div>
            <% }) %>
          <% } else { %>
            <p style="color:var(--success);font-size:13px;">Tidak ada tunggakan</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
