<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/sidebar') %>
<div class="main">
  <%- include('../partials/topbar', { pageTitle: 'Manajemen Tarif' }) %>
  <div class="content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <h1 class="page-title">Struktur Tarif Air</h1>
      <% if (['super_admin','admin_pam'].includes(user.role)) { %>
      <a href="/tarif/tambah" class="btn btn-primary">+ Tambah Tarif</a>
      <% } %>
    </div>
    <div class="card">
      <form method="GET" class="search-bar">
        <input name="q" class="search-input" placeholder="Cari nama tarif..." value="<%= q || '' %>">
        <select name="is_active" class="form-control" style="width:auto;">
          <option value="">Semua Status</option>
          <option value="1" <%=is_active==='1'?'selected':''%>>Aktif</option>
          <option value="0" <%=is_active==='0'?'selected':''%>>Nonaktif</option>
        </select>
        <button type="submit" class="btn btn-primary">Cari</button>
        <a href="/tarif" class="btn btn-secondary">Reset</a>
      </form>
      <div class="table-wrap">
        <table>
          <thead><tr><th style="width:40px;">No</th><th>Nama Tarif</th><th>Kategori</th><th>Harga/m³</th><th>Biaya Admin</th><th>Min. Bayar</th><th>Min. m³</th><th>Denda (%)</th><th>Berlaku</th><th>Status</th><th>Aksi</th></tr></thead>
          <tbody>
            <% if (tarifList.length === 0) { %><tr><td colspan="10" style="text-align:center;color:var(--muted);padding:32px;">Belum ada tarif. <a href="/tarif/tambah" style="color:var(--primary);">Tambah sekarang</a></td></tr><% } %>
            <% tarifList.forEach((t, i) => { %>
            <tr>
              <td style="color:var(--muted);font-size:12px;"><%= (page-1)*limit + i + 1 %></td>
              <td><strong><%= t.nama_tarif %></strong></td>
              <td><%= t.kategori ? t.kategori.nama : 'Semua' %></td>
              <td><%= formatRupiah(t.harga_per_m3) %></td>
              <td><%= formatRupiah(t.biaya_admin) %></td>
              <td><%= formatRupiah(t.biaya_minimum) %></td>
              <td><%= t.minimum_m3 %> m³</td>
              <td><%= t.denda_persen %>%</td>
              <td><%= formatTanggal(t.tanggal_berlaku) %></td>
              <td><span class="badge badge-<%= t.is_active ? 'success' : 'muted' %>"><%= t.is_active ? 'Aktif' : 'Nonaktif' %></span></td>
              <td style="white-space:nowrap;">
                <% if (['super_admin','admin_pam'].includes(user.role)) { %>
                <a href="/tarif/<%= t.id %>/edit" class="btn btn-secondary btn-xs">Edit</a>
                <form method="POST" action="/tarif/<%= t.id %>/toggle" style="display:inline;">
                  <button type="submit" class="btn btn-<%= t.is_active ? 'danger' : 'success' %> btn-xs"><%= t.is_active ? 'Nonaktifkan' : 'Aktifkan' %></button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (totalPages > 1) { %>
      <div class="pagination">
        <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>&q=<%= q||'' %>&is_active=<%= is_active||'' %>" class="page-btn <%= i === page ? 'active' : '' %>"><%= i %></a>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>
