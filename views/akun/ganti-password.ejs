<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/sidebar') %>
<div class="main">
  <%- include('../partials/topbar', { pageTitle: 'Ganti Password' }) %>
  <div class="content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <h1 class="page-title">Ganti Password</h1>
    </div>
    <div class="card" style="max-width:440px;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--border);">
        <div style="width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--secondary));display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:#fff;flex-shrink:0;">
          <%= user.nama.charAt(0).toUpperCase() %>
        </div>
        <div>
          <div style="font-weight:600;font-size:14px;"><%= user.nama %></div>
          <div style="font-size:12px;color:var(--muted);"><%= user.username %> &middot; <%= user.role.replace(/_/g,' ') %></div>
        </div>
      </div>
      <form method="POST" action="/akun/ganti-password">
        <div class="form-group">
          <label class="form-label">Password Lama</label>
          <div style="position:relative;">
            <input type="password" name="password_lama" id="passLama" class="form-control" placeholder="Masukkan password saat ini" required autocomplete="current-password">
            <button type="button" onclick="toggleVis('passLama','eyeLama')" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--muted);cursor:pointer;padding:4px;" tabindex="-1">
              <svg id="eyeLama" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Password Baru</label>
          <div style="position:relative;">
            <input type="password" name="password_baru" id="passBaru" class="form-control" placeholder="Masukkan password baru" required autocomplete="new-password" oninput="cekKekuatan(this.value)">
            <button type="button" onclick="toggleVis('passBaru','eyeBaru')" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--muted);cursor:pointer;padding:4px;" tabindex="-1">
              <svg id="eyeBaru" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <div style="margin-top:6px;display:flex;gap:4px;" id="kekuatanBar">
            <div id="kb1" style="height:3px;flex:1;border-radius:2px;background:var(--border);transition:background .3s;"></div>
            <div id="kb2" style="height:3px;flex:1;border-radius:2px;background:var(--border);transition:background .3s;"></div>
            <div id="kb3" style="height:3px;flex:1;border-radius:2px;background:var(--border);transition:background .3s;"></div>
          </div>
          <small id="kekuatanLabel" style="font-size:11px;color:var(--muted);display:block;margin-top:4px;"></small>
        </div>
        <div class="form-group">
          <label class="form-label">Konfirmasi Password Baru</label>
          <div style="position:relative;">
            <input type="password" name="password_konfirm" id="passKonfirm" class="form-control" placeholder="Ulangi password baru" required autocomplete="new-password" oninput="cekKonfirm()">
            <button type="button" onclick="toggleVis('passKonfirm','eyeKonfirm')" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--muted);cursor:pointer;padding:4px;" tabindex="-1">
              <svg id="eyeKonfirm" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <small id="konfirmHint" style="font-size:11px;display:block;margin-top:4px;"></small>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Simpan Password Baru
        </button>
      </form>
    </div>
  </div>
</div>
<script>
function toggleVis(inputId, iconId) {
  const inp = document.getElementById(inputId);
  inp.type = inp.type === 'password' ? 'text' : 'password';
}
function cekKekuatan(val) {
  const bars = [document.getElementById('kb1'), document.getElementById('kb2'), document.getElementById('kb3')];
  const label = document.getElementById('kekuatanLabel');
  bars.forEach(b => b.style.background = 'var(--border)');
  if (!val) { label.textContent = ''; return; }
  let skor = 0;
  if (val.length >= 4) skor++;
  if (val.length >= 8) skor++;
  if (/[A-Z]/.test(val) || /[0-9]/.test(val) || /[^A-Za-z0-9]/.test(val)) skor++;
  const warna = ['#ef4444','#f59e0b','#10b981'];
  const teks = ['Lemah','Sedang','Kuat'];
  for (let i = 0; i < skor; i++) bars[i].style.background = warna[skor - 1];
  label.textContent = 'Kekuatan: ' + (teks[skor - 1] || '');
  label.style.color = warna[skor - 1];
}
function cekKonfirm() {
  const baru = document.getElementById('passBaru').value;
  const konfirm = document.getElementById('passKonfirm').value;
  const hint = document.getElementById('konfirmHint');
  if (!konfirm) { hint.textContent = ''; return; }
  if (konfirm === baru) { hint.textContent = '✓ Password cocok'; hint.style.color = 'var(--success)'; }
  else { hint.textContent = '✗ Password tidak cocok'; hint.style.color = 'var(--danger)'; }
}
</script>
</body>
</html>
